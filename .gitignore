# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# firebase — service-account keys grant full admin access, never commit them
service-account*.json
*-firebase-adminsdk-*.json
.firebase/
firebase-debug.log*

# Shared test logins. These are real accounts on the live Firebase project and
# this repository is public, so the credentials stay out of it.
TEST_ACCOUNTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
