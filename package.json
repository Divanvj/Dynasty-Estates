{
  "name": "dynasty-estates-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:alt": "next dev -p 3100 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "test:rules": "npx --yes firebase-tools@15.37.0 emulators:exec --only firestore --project demo-dynasty-rules \"node tests/firestore-rules.test.mjs\"",
    "test:storage-rules": "npx --yes firebase-tools@15.37.0 emulators:exec --only storage --project demo-dynasty-rules \"node tests/storage-rules.test.mjs\"",
    "firebase:config": "npx --yes firebase-tools@15.37.0 apps:sdkconfig WEB --project dynasty-estates",
    "firebase:deploy:rules": "node scripts/firebase-deploy.mjs rules",
    "firebase:deploy:indexes": "node scripts/firebase-deploy.mjs indexes",
    "firebase:deploy:storage": "node scripts/firebase-deploy.mjs storage"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "^14.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
