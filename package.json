{
  "name": "dynasty-estates-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "firebase:config": "firebase-tools apps:sdkconfig WEB --project dynasty-estates",
    "firebase:deploy:auth": "firebase-tools deploy --only auth --project dynasty-estates",
    "firebase:deploy:rules": "firebase-tools deploy --only firestore:rules --project dynasty-estates",
    "firebase:deploy:storage": "firebase-tools deploy --only storage --project dynasty-estates",
    "firebase:seed-roles": "node scripts/seed-firebase-roles.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-admin": "^14.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
