# Firebase Web SDK Configuration — project: dynasty-estates
#
# Fill these in to switch Dynasty Estates from the built-in demo personas onto
# real Firebase Authentication + Cloud Firestore. If ANY value is left empty the
# app falls back to the local demo accounts in src/lib/demo-accounts.ts, so the
# shared partner link keeps working.
#
# Get these values with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project dynasty-estates
#
# See docs/FIREBASE_SETUP.md for the full walkthrough.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dynasty-estates.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dynasty-estates
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dynasty-estates.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The public origin this deployment serves from. Drives every canonical URL,
# sitemap entry, breadcrumb, Open Graph URL and the property link inside a
# shared WhatsApp message — see src/lib/site-url.ts.
#
# Leave blank in development. Set it in the hosting provider the moment a custom
# domain goes live; until then it falls back to the Vercel production URL, which
# is the host that actually answers.
#
#   NEXT_PUBLIC_SITE_URL=https://dynastyestates.co.za
NEXT_PUBLIC_SITE_URL=
