rules_version = '2';

// Listing photos. Every file here has already passed the checks in
// src/lib/photo-intake.ts and been re-encoded to JPEG by the browser. These
// rules cannot re-run those checks; they bound what a client that skips the
// wizard can store, and moderation is the backstop for the rest.
service firebase.storage {
  match /b/{bucket}/o {
    match /listing-photos/{ownerId}/{photoId} {
      // Public: listing photos are shown to every visitor. Paths carry a
      // random UUID, so draft photos are not discoverable by listing them.
      allow read: if true;
      // resource == null: Storage counts overwriting an existing file as a
      // create, so this is what stops a checked file being replaced in place.
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == ownerId
        && photoId.matches('[0-9a-f-]{36}\\.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 10 * 1024 * 1024;
      // Replacing a checked photo in place would bypass the checks.
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.role == 'admin');
    }

    // Floor plans attached by the listing agent. Drawings and PDFs, stored
    // as uploaded (see uploadFloorPlan in src/lib/photo-intake.ts).
    match /floor-plans/{ownerId}/{fileId} {
      allow read: if true;
      // resource == null: Storage counts overwriting an existing file as a
      // create, so this is what stops a checked file being replaced in place.
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == ownerId
        && fileId.matches('[0-9a-f-]{36}\\.(jpg|png|webp|pdf)')
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && request.resource.size < 10 * 1024 * 1024;
      allow update: if false;
      allow delete: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.token.role == 'admin');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
