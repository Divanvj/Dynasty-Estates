rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAgentOrAdmin() {
      return signedIn() && (
        request.auth.token.role == 'agent' ||
        request.auth.token.role == 'admin'
      );
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // A moderator reviews submitted listings and reads the audit trail, and
    // nothing else (item 1.3, decision 2). Decisions go through
    // /api/admin/moderation (Admin SDK), which writes the listing's status and
    // the audit entry together, so a moderator writes nothing directly.
    function isModerator() {
      return signedIn() && request.auth.token.role == 'moderator';
    }
    function canModerate() {
      return isAdmin() || isModerator();
    }

    // Agencies (PLAN.md F4, Phase G). A principal's agency is agencies/{their
    // uid}; each agent who joined has agency_members/{principalUid}_{memberUid}.
    // The principal reaches a member's enquiries and stats through that link,
    // so nothing is copied onto listings or enquiries and leaving takes effect
    // at once.
    function principalOf(ownerId) {
      return signedIn() && exists(/databases/$(database)/documents/agency_members/$(request.auth.uid + '_' + ownerId));
    }
    function isPrincipal() {
      return signedIn() && exists(/databases/$(database)/documents/agencies/$(request.auth.uid));
    }

    // The physical entity behind a listing (size, rooms, location). A listing in
    // /properties references one of these, so it must be world-readable for the
    // public catalogue. Only its creator, their agency principal or an admin
    // may change it (item 1.3: any agent used to be able to change any home).
    match /physical_properties/{physicalPropertyId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
            && (resource.data.ownerId == request.auth.uid
                || (resource.data.get('ownerId', null) is string && principalOf(resource.data.ownerId)))
            && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /properties/{propertyId} {
      // This list MUST stay identical to PUBLIC_LISTING_STATUSES in
      // src/lib/types/domain.ts. It previously held marketing labels ('Live',
      // 'Featured', 'Open house') rather than lifecycle statuses, so the
      // catalogue query — which asks for 'Published' — was denied outright and
      // the site fell back to demo data with nothing reporting a failure.
      // Sold and Rented stay readable so a listing's page still resolves after
      // the sale.
      function publicStatuses() {
        return ['Published', 'Under offer', 'Sold', 'Rented'];
      }

      // An owner must also be able to read back their own drafts, or the seller
      // portal cannot show them what they just filed, and an agency principal
      // sees their members' listings. Admins and moderators see everything in
      // order to review it. Any agent used to read every draft on the platform
      // (item 1.3).
      allow read: if resource.data.status in publicStatuses()
      || canModerate()
      || (signedIn() && resource.data.ownerId == request.auth.uid)
      || (resource.data.get('ownerId', null) is string && principalOf(resource.data.ownerId));
      // An owner may file a listing but not publish it: the button says "Submit
      // for Moderation", so only a practitioner may move it into a live state.
      // Set only by the server or a practitioner, never by the listing's own
      // owner: `example` (a Dynasty example home), `sale` (written by
      // /api/listings/[id]/sale) and `agentId` (who buyers are told to call; it
      // starts as the owner and must not be pointed at someone else).
      function ownerProtectedFields() {
        return ['example', 'sale', 'agentId'];
      }
      // A new listing needs a paid package (owner, 24 Nov 2026), for agents and
      // admins as well as private sellers. Online payment is not built yet, so
      // until it is only developer accounts may start one; the payment step
      // adds its own condition here. Listings that already exist are untouched.
      function mayStartListing() {
        return request.auth.token.get('developer', false) == true;
      }
      // A listing never carries its owner's e-mail address (audit item 1.5):
      // once published, anyone can read it. Buyers reach the owner through
      // enquiries, which the server e-mails. Listings filed before then may
      // still have one, so an edit may remove it but never add or change it.
      function ownerEmailOnlyRemoved() {
        return !('ownerEmail' in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerEmail']);
      }
      allow create: if signedIn()
        && mayStartListing()
        && !('ownerEmail' in request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        // Every new listing is reviewed, an agent's included (item 1.3): only an
        // admin may file one straight into another state.
        && (isAdmin()
            || (request.resource.data.status in ['Draft', 'Submitted']
                && !request.resource.data.keys().hasAny(['example', 'sale'])
                && request.resource.data.get('agentId', request.auth.uid) == request.auth.uid));
      // Who may change a listing (decision 1, owner 25 Nov 2026): its owner and
      // the principal of the agency the owner belongs to. Any agent used to be
      // able to edit or delete every listing on the platform (item 1.3).
      function mayEditListing() {
        return signedIn()
          && (resource.data.ownerId == request.auth.uid
              || (resource.data.get('ownerId', null) is string && principalOf(resource.data.ownerId)));
      }
      // Putting a listing in front of the public is a review decision (admin or
      // moderator, through /api/admin/moderation), never the owner's. An owner
      // may take a listing out of view, save a draft or resubmit it; an agent
      // may also edit a live listing and keep its status, as the wizard does.
      // Under offer / Sold / Rented go through the server's own routes.
      function ownerStatusAllowed() {
        return request.resource.data.status in ['Draft', 'Submitted', 'Paused', 'Archived']
          || (isAgentOrAdmin() && request.resource.data.status == resource.data.status);
      }
      allow update: if ownerEmailOnlyRemoved() && (isAdmin()
        || (mayEditListing()
            && request.resource.data.ownerId == resource.data.ownerId
            && ownerStatusAllowed()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerProtectedFields())));
      // Only the owner (or an admin) deletes; a principal may edit a member's
      // listing but not remove it.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /savedProperties/{propertyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tenancy applications carry identity-document and income data, so reads are
    // limited to the applicant and admins. Any agent used to be able to read
    // every application on the platform; an application carries no listing
    // owner to scope a vetting agent to, and no agent screen reads them, so
    // that access is closed until vetting is built with an owner on each one.
    // Nobody may delete one, and an applicant may not edit an application
    // after filing it or promote their own status.
    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.creditConsent == true
        && request.resource.data.status == 'submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.applicantId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Readable by the sender, by admins, and by the account that listed the
    // home (ownerId) — a private seller or an agent sees enquiries on their own
    // listings and nobody else's. Agents used to read every enquiry on the
    // platform, so the agent dashboard showed each agent other agents' and
    // private sellers' buyers (names, emails, phone numbers).
    // The sender cannot choose ownerId: it must match the listing's owner, or
    // anyone could drop messages into a stranger's inbox. It may be left off
    // (sample listings, agent profiles, and clients older than this rule); then
    // only the sender and admins see the enquiry. The owner may change its
    // status and nothing else.
    match /inquiries/{inquiryId} {
      // A new enquiry starts at "new", unassigned and unanswered: the sender
      // may not file one as won, assign it to an agent (who could then read
      // it) or give it a first reply.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', 'new') == 'new'
        && !request.resource.data.keys().hasAny(['assignedTo', 'firstRespondedAt', 'updatedAt'])
        && (!('ownerId' in request.resource.data)
            || request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId);
      // Also: the principal of an agency the owner belongs to, and the agent
      // the enquiry is assigned to (Phase G).
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.get('assignedTo', null) == request.auth.uid)
        || principalOf(resource.data.ownerId);
      // The listing owner — or the agent it is assigned to — moves an enquiry
      // through its stages (F2, Phase D). Private sellers: new / contacted.
      // Agents (and admins) also: viewing, offer, won, lost. updatedAt, when
      // sent, is the server clock. firstRespondedAt is the first reply:
      // settable once, only as the enquiry leaves "new", only to the server
      // clock, never removed.
      // A principal assigns (or unassigns) an enquiry on their own or a
      // member's listing to themselves or a member, changing nothing else.
      allow update: if isAdmin()
        || ((principalOf(resource.data.ownerId) || (resource.data.ownerId == request.auth.uid && isPrincipal()))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTo', 'updatedAt'])
            && (!('assignedTo' in request.resource.data)
                || request.resource.data.assignedTo == request.auth.uid
                || exists(/databases/$(database)/documents/agency_members/$(request.auth.uid + '_' + request.resource.data.assignedTo)))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
                || request.resource.data.updatedAt == request.time))
        || (signedIn()
            && (resource.data.ownerId == request.auth.uid || resource.data.get('assignedTo', null) == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'firstRespondedAt'])
            && (request.resource.data.status in ['new', 'contacted']
                || (isAgentOrAdmin() && request.resource.data.status in ['viewing', 'offer', 'won', 'lost']))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
                || request.resource.data.updatedAt == request.time)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstRespondedAt'])
                || (!('firstRespondedAt' in resource.data)
                    && resource.data.status == 'new'
                    && request.resource.data.status != 'new'
                    && request.resource.data.firstRespondedAt == request.time)));
      allow delete: if isAdmin();
    }

    // Perceptual hashes of every photo on a saved listing, for duplicate
    // detection at upload (src/lib/photo-intake.ts). Any signed-in uploader
    // must be able to query them; they hold a hash, not the image. A
    // fingerprint may only be filed for a listing the writer owns, checked
    // against the listing written in the same batch, so nobody can pre-register
    // someone else's photos to block them. Immutable once written.
    match /photo_fingerprints/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hash', 'bands', 'ownerId', 'listingId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 16
        && request.resource.data.bands is list
        && request.resource.data.bands.size() == 4
        && request.resource.data.listingId is string
        && getAfter(/databases/$(database)/documents/properties/$(request.resource.data.listingId)).data.ownerId == request.auth.uid;
      allow update: if false;
      // The nightly clean-up deletes stale ones with the Admin SDK. From the
      // browser only the listing's owner or an admin may (item 1.3: any agent
      // could delete anyone's, letting a re-used photo past the duplicate check).
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Shared property shortlists (src/lib/collections.ts). Access is scoped to
    // the owner, which is exactly what the only query over this collection
    // asks for — where('ownerId', '==', uid). A document also carries a
    // `members` array with 'collaborator' and 'viewer' entries, but nothing
    // grants on it: there is no invite flow, and an array of maps cannot be
    // tested in a rule anyway. Honouring collaborators needs a queryable
    // `memberIds` array written at create time first, so until that exists a
    // rule referencing members would be decoration, not access control.
    // The owner is pinned on update so a collection cannot be reassigned.
    match /collections/{collectionId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Support & Guidance messages (src/lib/support-requests.ts). Filed by the
    // signed-in sender as themselves; only admins read and triage them.
    match /support_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'message', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new';
      allow read: if (signedIn() && request.auth.token.role == 'admin')
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn() && request.auth.token.role == 'admin';
      allow delete: if false;
    }

    // Practitioner compliance (src/lib/practitioners.ts, PLAN.md F3). The
    // practitioner files their own FFC details; every save is a fresh
    // "pending" application at the server's time, so an edited certificate is
    // checked again. Only /api/admin/practitioners (Admin SDK) decides one:
    // verified / rejected, verifiedAt, verifiedBy, decisionNote, and the agent
    // role claim. No client may write those, delete an application, or read
    // anyone else's.
    match /practitioners/{uid} {
      function ownerFields() {
        return ['fullName', 'email', 'phone', 'ffcNumber', 'ffcExpiry', 'agencyName', 'status', 'submittedAt'];
      }
      function validApplication(d) {
        return d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 120
          && d.phone is string && d.phone.size() <= 40
          && d.ffcNumber is string && d.ffcNumber.size() >= 3 && d.ffcNumber.size() <= 40
          && d.ffcExpiry is string && d.ffcExpiry.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.agencyName is string && d.agencyName.size() <= 120
          && d.email == request.auth.token.get('email', null)
          && d.status == 'pending'
          && d.submittedAt == request.time;
      }
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(ownerFields())
        && validApplication(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerFields())
        && validApplication(request.resource.data);
      allow delete: if false;
    }

    // An agency, keyed by its principal's uid (one agency per principal).
    // Only an agent whose Fidelity Fund Certificate an admin has verified may
    // register one. Members read it; nobody deletes it from the app.
    match /agencies/{principalUid} {
      function validAgency(d) {
        return d.name is string && d.name.size() >= 2 && d.name.size() <= 120
          && d.ppraFirmNumber is string && d.ppraFirmNumber.size() <= 40
          && d.principalUid == principalUid;
      }
      allow read: if isOwner(principalUid) || isAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/agency_members/$(principalUid + '_' + request.auth.uid)));
      allow create: if isOwner(principalUid) && isAgentOrAdmin()
        && get(/databases/$(database)/documents/practitioners/$(request.auth.uid)).data.status == 'verified'
        && request.resource.data.keys().hasOnly(['name', 'ppraFirmNumber', 'principalUid', 'createdAt'])
        && validAgency(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(principalUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ppraFirmNumber'])
        && validAgency(request.resource.data);
      allow delete: if false;
    }

    // An invitation to join an agency, keyed {principalUid}_{e-mail in lower
    // case}. No e-mail is sent yet: the invited agent sees it in their account.
    match /agency_invites/{inviteId} {
      allow read: if signedIn() && (resource.data.principalUid == request.auth.uid
        || resource.data.email == request.auth.token.get('email', '').lower());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['principalUid', 'agencyName', 'email', 'invitedAt'])
        && request.resource.data.principalUid == request.auth.uid
        && isPrincipal()
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email != request.auth.token.get('email', '').lower()
        && inviteId == request.auth.uid + '_' + request.resource.data.email
        && request.resource.data.agencyName == get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.name
        && request.resource.data.invitedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.principalUid == request.auth.uid
        || resource.data.email == request.auth.token.get('email', '').lower());
    }

    // Membership: {principalUid}_{memberUid}. Created by the invited agent,
    // only while an invitation to their own e-mail exists; removed by either
    // side. This link is what principalOf() checks.
    match /agency_members/{linkId} {
      allow read: if signedIn() && (resource.data.principalUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow create: if signedIn() && isAgentOrAdmin()
        && request.resource.data.keys().hasOnly(['principalUid', 'memberUid', 'name', 'email', 'joinedAt'])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.principalUid != request.auth.uid
        && linkId == request.resource.data.principalUid + '_' + request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '').lower()
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && exists(/databases/$(database)/documents/agency_invites/$(request.resource.data.principalUid + '_' + request.auth.token.get('email', '').lower()))
        && request.resource.data.joinedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.principalUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
    }

    // Daily view / save / contact-click counts per listing (lib/listing-stats.ts,
    // docs/dashboards/PLAN.md F1). Only the server writes them, through the
    // Admin SDK in /api/track, which reads the owner from the listing itself.
    // The listing's owner and admins may read; no client may write.
    match /listing_stats/{statId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid) || principalOf(resource.data.ownerId);
      allow write: if false;
    }

    // Append-only record of every moderation decision (src/lib/moderation.ts).
    // recordAuditLog() runs before the listing update it describes, so with no
    // rule here the write was denied and every moderation decision failed
    // before it began. An entry may only be filed by a practitioner, as
    // themselves, so a decision cannot be attributed to someone else; and
    // nothing may edit or remove one, because an audit trail that its own
    // subject can rewrite is not evidence of anything.
    // The audit trail is written only by the server (Admin SDK): moderation
    // decisions (/api/admin/moderation), practitioner decisions, sales and
    // market-status changes. Any agent used to be able to file entries from the
    // browser and read the whole trail (item 1.3).
    match /audit_logs/{logId} {
      allow read: if canModerate();
      allow create, update, delete: if false;
    }
  }
}
