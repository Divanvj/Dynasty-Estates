rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAgentOrAdmin() {
      return signedIn() && (
        request.auth.token.role == 'agent' ||
        request.auth.token.role == 'admin'
      );
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // The physical entity behind a listing (size, rooms, location). A listing in
    // /properties references one of these, so it must be world-readable for the
    // public catalogue, but only its creator or a practitioner may change it.
    match /physical_properties/{physicalPropertyId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAgentOrAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAgentOrAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /properties/{propertyId} {
      // This list MUST stay identical to PUBLIC_LISTING_STATUSES in
      // src/lib/types/domain.ts. It previously held marketing labels ('Live',
      // 'Featured', 'Open house') rather than lifecycle statuses, so the
      // catalogue query — which asks for 'Published' — was denied outright and
      // the site fell back to demo data with nothing reporting a failure.
      // Sold and Rented stay readable so a listing's page still resolves after
      // the sale.
      function publicStatuses() {
        return ['Published', 'Under offer', 'Sold', 'Rented'];
      }

      // An owner must also be able to read back their own drafts, or the seller
      // portal cannot show them what they just filed; practitioners see
      // everything in order to moderate it.
      allow read: if resource.data.status in publicStatuses()
      || isAgentOrAdmin()
      || (signedIn() && resource.data.ownerId == request.auth.uid);
      // An owner may file a listing but not publish it: the button says "Submit
      // for Moderation", so only a practitioner may move it into a live state.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (isAgentOrAdmin() || request.resource.data.status in ['Draft', 'Submitted']);
      allow update: if isAgentOrAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.status in ['Draft', 'Submitted', 'Paused', 'Archived']);
      allow delete: if isAgentOrAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /savedProperties/{propertyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tenancy applications carry identity-document and income data, so reads are
    // limited to the applicant and to practitioners who must vet them. Nobody
    // may delete one, and an applicant may not edit an application after filing
    // it or promote their own status.
    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.creditConsent == true
        && request.resource.data.status == 'submitted';
      allow read: if isAgentOrAdmin() || (signedIn() && resource.data.applicantId == request.auth.uid);
      allow update: if isAgentOrAdmin();
      allow delete: if false;
    }

    // Readable by the sender, by admins, and by the account that listed the
    // home (ownerId) — a private seller or an agent sees enquiries on their own
    // listings and nobody else's. Agents used to read every enquiry on the
    // platform, so the agent dashboard showed each agent other agents' and
    // private sellers' buyers (names, emails, phone numbers).
    // The sender cannot choose ownerId: it must match the listing's owner, or
    // anyone could drop messages into a stranger's inbox. It may be left off
    // (sample listings, agent profiles, and clients older than this rule); then
    // only the sender and admins see the enquiry. The owner may change its
    // status and nothing else.
    match /inquiries/{inquiryId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('ownerId' in request.resource.data)
            || request.resource.data.ownerId == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId);
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      // The listing owner moves an enquiry through its stages (F2, Phase D).
      // Private sellers: new / contacted. Agents (and admins) also: viewing,
      // offer, won, lost. updatedAt, when sent, is the server clock.
      // firstRespondedAt is the first reply: settable once, only as the
      // enquiry leaves "new", only to the server clock, never removed.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'firstRespondedAt'])
            && (request.resource.data.status in ['new', 'contacted']
                || (isAgentOrAdmin() && request.resource.data.status in ['viewing', 'offer', 'won', 'lost']))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
                || request.resource.data.updatedAt == request.time)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstRespondedAt'])
                || (!('firstRespondedAt' in resource.data)
                    && resource.data.status == 'new'
                    && request.resource.data.status != 'new'
                    && request.resource.data.firstRespondedAt == request.time)));
      allow delete: if isAdmin();
    }

    // Perceptual hashes of every photo on a saved listing, for duplicate
    // detection at upload (src/lib/photo-intake.ts). Any signed-in uploader
    // must be able to query them; they hold a hash, not the image. A
    // fingerprint may only be filed for a listing the writer owns, checked
    // against the listing written in the same batch, so nobody can pre-register
    // someone else's photos to block them. Immutable once written.
    match /photo_fingerprints/{photoId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hash', 'bands', 'ownerId', 'listingId', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 16
        && request.resource.data.bands is list
        && request.resource.data.bands.size() == 4
        && request.resource.data.listingId is string
        && getAfter(/databases/$(database)/documents/properties/$(request.resource.data.listingId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAgentOrAdmin();
    }

    // Shared property shortlists (src/lib/collections.ts). Access is scoped to
    // the owner, which is exactly what the only query over this collection
    // asks for — where('ownerId', '==', uid). A document also carries a
    // `members` array with 'collaborator' and 'viewer' entries, but nothing
    // grants on it: there is no invite flow, and an array of maps cannot be
    // tested in a rule anyway. Honouring collaborators needs a queryable
    // `memberIds` array written at create time first, so until that exists a
    // rule referencing members would be decoration, not access control.
    // The owner is pinned on update so a collection cannot be reassigned.
    match /collections/{collectionId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Support & Guidance messages (src/lib/support-requests.ts). Filed by the
    // signed-in sender as themselves; only admins read and triage them.
    match /support_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'message', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new';
      allow read: if (signedIn() && request.auth.token.role == 'admin')
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn() && request.auth.token.role == 'admin';
      allow delete: if false;
    }

    // Practitioner compliance (src/lib/practitioners.ts, PLAN.md F3). The
    // practitioner files their own FFC details; every save is a fresh
    // "pending" application at the server's time, so an edited certificate is
    // checked again. Only /api/admin/practitioners (Admin SDK) decides one:
    // verified / rejected, verifiedAt, verifiedBy, decisionNote, and the agent
    // role claim. No client may write those, delete an application, or read
    // anyone else's.
    match /practitioners/{uid} {
      function ownerFields() {
        return ['fullName', 'email', 'phone', 'ffcNumber', 'ffcExpiry', 'agencyName', 'status', 'submittedAt'];
      }
      function validApplication(d) {
        return d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 120
          && d.phone is string && d.phone.size() <= 40
          && d.ffcNumber is string && d.ffcNumber.size() >= 3 && d.ffcNumber.size() <= 40
          && d.ffcExpiry is string && d.ffcExpiry.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.agencyName is string && d.agencyName.size() <= 120
          && d.email == request.auth.token.get('email', null)
          && d.status == 'pending'
          && d.submittedAt == request.time;
      }
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(ownerFields())
        && validApplication(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerFields())
        && validApplication(request.resource.data);
      allow delete: if false;
    }

    // Daily view / save / contact-click counts per listing (lib/listing-stats.ts,
    // docs/dashboards/PLAN.md F1). Only the server writes them, through the
    // Admin SDK in /api/track, which reads the owner from the listing itself.
    // The listing's owner and admins may read; no client may write.
    match /listing_stats/{statId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    // Append-only record of every moderation decision (src/lib/moderation.ts).
    // recordAuditLog() runs before the listing update it describes, so with no
    // rule here the write was denied and every moderation decision failed
    // before it began. An entry may only be filed by a practitioner, as
    // themselves, so a decision cannot be attributed to someone else; and
    // nothing may edit or remove one, because an audit trail that its own
    // subject can rewrite is not evidence of anything.
    match /audit_logs/{logId} {
      allow read: if isAgentOrAdmin();
      allow create: if isAgentOrAdmin()
        && request.resource.data.keys().hasOnly(['actorId', 'actorEmail', 'action', 'resource', 'details', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.resource is string;
      allow update, delete: if false;
    }
  }
}
